{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/boundary-facts.schema.json",
  "title": "BoundaryFacts",
  "type": "object",
  "required": [
    "id",
    "run_id",
    "workspace_id",
    "recorded_at",
    "entry_surface",
    "authority",
    "known_facts",
    "not_recorded",
    "limits",
    "impact",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^boundary_[A-Za-z0-9_-]+$" },
    "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]+$" },
    "workspace_id": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "format": "date-time" },
    "entry_surface": { "type": "string", "enum": ["tui", "gui", "im", "browser", "api", "system"] },
    "authority": { "type": "string", "enum": ["typescript-seed", "rust-supervisor"] },
    "known_facts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["run_id", "workspace_id", "entry_surface", "authority"]
      }
    },
    "not_recorded": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["user_id", "device_id", "channel_id", "secret_vault"]
      }
    },
    "limits": {
      "type": "object",
      "required": ["full_user_identity", "device_pairing", "remote_channel_identity", "secret_vault_backend"],
      "additionalProperties": false,
      "properties": {
        "full_user_identity": { "type": "boolean", "enum": [false] },
        "device_pairing": { "type": "boolean", "enum": [false] },
        "remote_channel_identity": { "type": "boolean", "enum": [false] },
        "secret_vault_backend": { "type": "boolean", "enum": [false] }
      }
    },
    "impact": {
      "type": "object",
      "required": [
        "memory_candidate_created",
        "user_model_updated",
        "capability_changed",
        "runtime_permissions_changed",
        "external_delivery_attempted",
        "browser_automation_attempted",
        "connector_called",
        "package_code_executed",
        "workspace_file_write_requested"
      ],
      "additionalProperties": false,
      "properties": {
        "memory_candidate_created": { "type": "boolean" },
        "user_model_updated": { "type": "boolean" },
        "capability_changed": { "type": "boolean" },
        "runtime_permissions_changed": { "type": "boolean" },
        "external_delivery_attempted": { "type": "boolean", "enum": [false] },
        "browser_automation_attempted": { "type": "boolean", "enum": [false] },
        "connector_called": { "type": "boolean", "enum": [false] },
        "package_code_executed": { "type": "boolean", "enum": [false] },
        "workspace_file_write_requested": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["run_manifest", "workspace_registry", "ledger_event"],
      "additionalProperties": false,
      "properties": {
        "run_manifest": { "type": "string", "enum": ["recorded"] },
        "workspace_registry": { "type": "string", "enum": ["recorded"] },
        "ledger_event": { "type": "string", "enum": ["run.started"] }
      }
    }
  }
}
