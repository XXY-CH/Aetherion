{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/counterfactual-report.schema.json",
  "title": "CounterfactualReport",
  "type": "object",
  "required": ["id", "checkpoint_id", "checkpoint_event_id", "change", "mode", "live_side_effects_allowed", "confidence", "summary", "status", "evidence", "affected_events", "assumptions", "unknowns", "source_redacted"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^counterfactual_[A-Za-z0-9_-]+$" },
    "checkpoint_id": { "type": "string" },
    "checkpoint_event_id": { "type": "string" },
    "change": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["report"] },
    "live_side_effects_allowed": { "type": "boolean", "enum": [false] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "summary": { "type": "string" },
    "status": { "type": "string", "enum": ["partial", "insufficient_evidence"] },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "affected_events": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "source_redacted": { "type": "boolean" }
  }
}
