{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/memory-candidate.schema.json",
  "title": "MemoryCandidate",
  "type": "object",
  "required": ["id", "source_events", "candidate", "confidence", "review"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^memcand_[A-Za-z0-9_-]+$" },
    "source_events": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "candidate": { "$ref": "memory-card.schema.json" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "review": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "reviewer": { "type": "string" }
      }
    }
  }
}
