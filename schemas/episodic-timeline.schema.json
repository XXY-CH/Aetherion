{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/episodic-timeline.schema.json",
  "title": "EpisodicTimeline",
  "type": "object",
  "required": ["id", "run_id", "source_events", "user_intent", "steps_taken", "tools_used", "failures", "recoveries", "user_corrections", "final_artifact", "skill_candidates", "regression_cases"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^episode_[A-Za-z0-9_-]+$" },
    "run_id": { "type": "string" },
    "source_events": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "user_intent": { "type": "string" },
    "steps_taken": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "event_type", "summary"],
        "additionalProperties": false,
        "properties": {
          "event_id": { "type": "string" },
          "event_type": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "tools_used": { "type": "array", "items": { "type": "string" } },
    "failures": { "type": "array", "items": { "type": "string" } },
    "recoveries": { "type": "array", "items": { "type": "string" } },
    "user_corrections": { "type": "array", "items": { "type": "string" } },
    "final_artifact": { "type": "string" },
    "skill_candidates": { "type": "array", "items": { "type": "string" } },
    "regression_cases": { "type": "array", "items": { "type": "string" } }
  }
}
