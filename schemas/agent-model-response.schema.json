{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/agent-model-response.schema.json",
  "title": "AgentModelResponse",
  "type": "object",
  "required": [
    "id",
    "request_id",
    "request_artifact_ref",
    "run_id",
    "runtime_invocation_id",
    "runtime_invocation_artifact_ref",
    "schema_version",
    "status",
    "scope",
    "provider",
    "response",
    "usage",
    "tool_gateway",
    "authority_gates",
    "response_audit",
    "response_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^agent_model_response_[A-Za-z0-9_-]+$" },
    "request_id": { "type": "string", "pattern": "^agent_model_request_[A-Za-z0-9_-]+$" },
    "request_artifact_ref": {
      "type": "string",
      "pattern": "^artifact://agent/model-request/agent_model_request_[A-Za-z0-9_-]+$"
    },
    "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]+$" },
    "runtime_invocation_id": { "type": "string", "pattern": "^agent_runtime_invocation_[A-Za-z0-9_-]+$" },
    "runtime_invocation_artifact_ref": {
      "type": "string",
      "pattern": "^artifact://agent/runtime/agent_runtime_invocation_[A-Za-z0-9_-]+$"
    },
    "schema_version": { "type": "string", "enum": ["aetherion-agent-model-response-v1"] },
    "status": { "type": "string", "enum": ["response_recorded"] },
    "scope": {
      "type": "object",
      "required": [
        "model_invoked",
        "provider_called",
        "tools_requested",
        "tool_execution_allowed",
        "raw_response_persisted",
        "raw_prompt_persisted",
        "raw_payload_artifacts_read",
        "runtime_authority_granted"
      ],
      "additionalProperties": false,
      "properties": {
        "model_invoked": { "type": "boolean", "enum": [true] },
        "provider_called": { "type": "boolean", "enum": [true] },
        "tools_requested": { "type": "boolean", "enum": [false] },
        "tool_execution_allowed": { "type": "boolean", "enum": [false] },
        "raw_response_persisted": { "type": "boolean", "enum": [false] },
        "raw_prompt_persisted": { "type": "boolean", "enum": [false] },
        "raw_payload_artifacts_read": { "type": "boolean", "enum": [false] },
        "runtime_authority_granted": { "type": "boolean", "enum": [false] }
      }
    },
    "provider": {
      "type": "object",
      "required": ["provider_ref", "model_ref", "credential_ref", "credential_resolved"],
      "additionalProperties": false,
      "properties": {
        "provider_ref": { "type": "string", "minLength": 1 },
        "model_ref": { "type": "string", "minLength": 1 },
        "credential_ref": { "type": "null" },
        "credential_resolved": { "type": "boolean", "enum": [false] }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "finish_reason",
        "response_payload_sha256",
        "output_text_sha256",
        "raw_response_payload_persisted",
        "output_artifact_ref",
        "refusal_present"
      ],
      "additionalProperties": false,
      "properties": {
        "finish_reason": { "type": "string", "enum": ["stop", "length", "content_filter", "tool_call", "error"] },
        "response_payload_sha256": { "$ref": "#/$defs/sha256" },
        "output_text_sha256": { "$ref": "#/$defs/sha256" },
        "raw_response_payload_persisted": { "type": "boolean", "enum": [false] },
        "output_artifact_ref": { "type": "null" },
        "refusal_present": { "type": "boolean" }
      }
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "total_tokens", "usage_source"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "usage_source": { "type": "string", "enum": ["provider_reported", "locally_estimated", "not_recorded"] }
      }
    },
    "tool_gateway": {
      "type": "object",
      "required": [
        "tool_calls_present",
        "proposed_tool_request_ids",
        "tool_request_events_appended",
        "execution_without_policy_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "tool_calls_present": { "type": "boolean" },
        "proposed_tool_request_ids": { "$ref": "#/$defs/stringArray" },
        "tool_request_events_appended": { "type": "boolean", "enum": [false] },
        "execution_without_policy_allowed": { "type": "boolean", "enum": [false] }
      }
    },
    "authority_gates": {
      "type": "object",
      "required": [
        "local_supervisor_required",
        "model_output_can_authorize_actions",
        "tool_request_event_requires_supervisor_path",
        "tool_execution_requires_scoped_lease",
        "side_effects_require_policy_or_approval"
      ],
      "additionalProperties": false,
      "properties": {
        "local_supervisor_required": { "type": "boolean", "enum": [true] },
        "model_output_can_authorize_actions": { "type": "boolean", "enum": [false] },
        "tool_request_event_requires_supervisor_path": { "type": "boolean", "enum": [true] },
        "tool_execution_requires_scoped_lease": { "type": "boolean", "enum": [true] },
        "side_effects_require_policy_or_approval": { "type": "boolean", "enum": [true] }
      }
    },
    "response_audit": {
      "type": "object",
      "required": [
        "required",
        "audit_artifact_ref",
        "passed",
        "may_present_as_verified_runtime_evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean", "enum": [true] },
        "audit_artifact_ref": { "type": "null" },
        "passed": { "type": "null" },
        "may_present_as_verified_runtime_evidence": { "type": "boolean", "enum": [false] }
      }
    },
    "response_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  }
}
