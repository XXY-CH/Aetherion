{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/local-ingress-idempotency-reservation.schema.json",
  "title": "LocalIngressIdempotencyReservation",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "workspace_id",
    "run_id",
    "reserved_at",
    "surface_id",
    "command",
    "key_source",
    "idempotency_key_hash",
    "normalized_intent_hash",
    "duplicate_detection_stage",
    "duplicate_detector",
    "auth_state",
    "rate_limit_state",
    "policy_handoff",
    "raw_key_persisted",
    "raw_intent_persisted",
    "can_authorize_actions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^local_ingress_idempotency_[a-f0-9]{16}$" },
    "schema_version": { "type": "string", "enum": ["aetherion-local-ingress-idempotency-reservation-v1"] },
    "workspace_id": { "type": "string", "pattern": "^ws_[a-f0-9]{16}$" },
    "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]+$" },
    "reserved_at": { "type": "string", "format": "date-time" },
    "surface_id": { "type": "string", "enum": ["tui"] },
    "command": { "type": "string", "enum": ["run"] },
    "key_source": { "type": "string", "enum": ["operator_supplied", "generated"] },
    "idempotency_key_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "normalized_intent_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "duplicate_detection_stage": { "type": "string", "enum": ["before_supervisor_handoff"] },
    "duplicate_detector": { "type": "string", "enum": ["local_atomic_reservation_file"] },
    "auth_state": { "type": "string", "enum": ["local_operator"] },
    "rate_limit_state": { "type": "string", "enum": ["enforced_allow"] },
    "policy_handoff": { "type": "string", "enum": ["pending_fresh_policy_and_scoped_lease"] },
    "raw_key_persisted": { "type": "boolean", "enum": [false] },
    "raw_intent_persisted": { "type": "boolean", "enum": [false] },
    "can_authorize_actions": { "type": "boolean", "enum": [false] }
  }
}
