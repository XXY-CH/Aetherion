{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/persona-reset.schema.json",
  "title": "PersonaReset",
  "type": "object",
  "required": ["id", "from_branch", "to_branch", "status", "retained_business_memory_ids", "activated_anchor_ids", "deactivated_anchor_ids", "inherits_live_authority", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^persona_reset_[A-Za-z0-9_-]+$" },
    "from_branch": { "type": ["string", "null"] },
    "to_branch": { "type": "string" },
    "status": { "type": "string", "enum": ["applied"] },
    "retained_business_memory_ids": { "type": "array", "items": { "type": "string" } },
    "activated_anchor_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "deactivated_anchor_ids": { "type": "array", "items": { "type": "string" } },
    "inherits_live_authority": { "type": "boolean", "enum": [false] },
    "created_at": { "type": "string" }
  }
}
