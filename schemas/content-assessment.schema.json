{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/content-assessment.schema.json",
  "title": "ContentAssessment",
  "type": "object",
  "required": ["id", "source_event_id", "source_kind", "content_sha256", "status", "matched_rules", "taint", "raw_content_persisted", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^assessment_[A-Za-z0-9_-]+$" },
    "source_event_id": { "type": "string" },
    "source_kind": { "type": "string", "enum": ["public_web", "email", "pdf", "im", "github_issue", "mcp_description", "third_party_content"] },
    "content_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": { "type": "string", "enum": ["clean", "suspicious"] },
    "matched_rules": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "taint": {
      "type": "object",
      "required": ["sources", "can_authorize_actions"],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": { "type": "string", "enum": ["public_web", "email", "pdf", "im", "github_issue", "mcp_description", "third_party_content"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "can_authorize_actions": { "type": "boolean", "enum": [false] }
      }
    },
    "raw_content_persisted": { "type": "boolean", "enum": [false] },
    "created_at": { "type": "string" }
  }
}
