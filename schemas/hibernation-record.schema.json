{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/hibernation-record.schema.json",
  "title": "HibernationRecord",
  "type": "object",
  "required": ["id", "run_id", "status", "created_at", "active_leases_retained", "minimal_context_pack_id"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^hibernate_[A-Za-z0-9_-]+$" },
    "run_id": { "type": "string" },
    "status": { "type": "string", "enum": ["sleeping", "waking", "completed", "expired"] },
    "created_at": { "type": "string" },
    "active_leases_retained": { "type": "boolean" },
    "minimal_context_pack_id": { "type": "string" }
  }
}
