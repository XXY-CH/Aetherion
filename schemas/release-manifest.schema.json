{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/release-manifest.schema.json",
  "title": "ReleaseManifest",
  "type": "object",
  "required": [
    "id",
    "repository",
    "source_revision",
    "generated_at",
    "status",
    "dependency_lockfiles",
    "test_gates",
    "artifact_hashes",
    "governance_docs",
    "bilingual_docs",
    "remote_observed_evidence",
    "known_gaps"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^release_manifest_[A-Za-z0-9_-]+$" },
    "repository": { "type": "string", "minLength": 1 },
    "source_revision": {
      "type": "object",
      "required": ["git_head", "git_head_short", "branch", "dirty"],
      "additionalProperties": false,
      "properties": {
        "git_head": { "type": "string", "minLength": 1 },
        "git_head_short": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" }
      }
    },
    "generated_at": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["candidate", "blocked", "draft"] },
    "dependency_lockfiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "test_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "command", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "status": { "$ref": "#/$defs/status" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "artifact_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "governance_docs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "bilingual_docs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "remote_observed_evidence": {
      "type": "object",
      "required": ["ci_status", "codeql_status", "snapshot_ref", "observed_at"],
      "additionalProperties": false,
      "properties": {
        "ci_status": { "type": "string", "enum": ["pass", "warn", "fail", "unknown", "not_checked"] },
        "codeql_status": { "type": "string", "enum": ["pass", "warn", "fail", "unknown", "not_configured"] },
        "snapshot_ref": { "type": ["string", "null"] },
        "observed_at": { "type": ["string", "null"] }
      }
    },
    "known_gaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "status": { "type": "string", "enum": ["pass", "warn", "fail", "not_applicable"] },
    "evidenceItem": {
      "type": "object",
      "required": ["name", "status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
