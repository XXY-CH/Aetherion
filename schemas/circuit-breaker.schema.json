{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/circuit-breaker.schema.json",
  "title": "CircuitBreaker",
  "type": "object",
  "required": ["id", "contract_id", "child_run_id", "trigger", "status", "action", "event_id", "reason", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^breaker_[A-Za-z0-9_-]+$" },
    "contract_id": { "type": "string" },
    "child_run_id": { "type": "string" },
    "trigger": { "type": "string", "enum": ["budget_exhausted", "repeated_policy_denial", "permission_violation", "poisoning_detected", "execution_failure"] },
    "status": { "type": "string", "enum": ["open", "closed"] },
    "action": { "type": "string", "enum": ["stop", "queue", "report"] },
    "event_id": { "type": "string" },
    "reason": { "type": "string" },
    "created_at": { "type": "string" }
  }
}
