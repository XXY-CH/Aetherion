{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/memory-fold.schema.json",
  "title": "MemoryFold",
  "type": "object",
  "required": ["id", "source_run_id", "folded_from", "source_events", "proposed_memory", "confidence", "created_at", "review_status", "accepted_memory_id", "replaces_active_memory", "sensitive_approval_required", "sensitive_approved"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^fold_[A-Za-z0-9_-]+$" },
    "source_run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]+$" },
    "folded_from": { "type": "array", "items": { "type": "string", "pattern": "^mem_[A-Za-z0-9_-]+$" }, "minItems": 2, "uniqueItems": true },
    "source_events": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "proposed_memory": {
      "type": "object",
      "required": ["id", "type", "subject", "content", "source_events", "confidence", "sensitivity"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^mem_[A-Za-z0-9_-]+$" },
        "type": { "type": "string", "enum": ["preference", "fact", "project", "relationship", "habit", "constraint"] },
        "subject": { "type": "string" },
        "content": { "type": "string" },
        "source_events": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "sensitivity": { "type": "string" },
        "ttl": { "type": "string" },
        "contradicts": { "type": "array", "items": { "type": "string" } },
        "allowed_contexts": { "type": "array", "items": { "type": "string" } },
        "blocked_contexts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string" },
    "review_status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
    "accepted_memory_id": { "type": ["string", "null"] },
    "replaces_active_memory": { "type": "boolean", "enum": [false] },
    "sensitive_approval_required": { "type": "boolean" },
    "sensitive_approved": { "type": "boolean" }
  }
}
