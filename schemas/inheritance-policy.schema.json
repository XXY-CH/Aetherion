{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/inheritance-policy.schema.json",
  "title": "InheritancePolicy",
  "type": "object",
  "required": ["id", "allowed", "denied", "requires_fresh_approval"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^inheritance_[A-Za-z0-9_-]+$" },
    "allowed": { "type": "array", "items": { "type": "string" } },
    "denied": { "type": "array", "items": { "type": "string" } },
    "requires_fresh_approval": { "type": "array", "items": { "type": "string" } }
  }
}
