{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/approval-card.schema.json",
  "title": "ApprovalCard",
  "type": "object",
  "required": ["id", "tool_request_id", "risk_level", "target", "expected_effect", "scope", "choices"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^approval_[A-Za-z0-9_-]+$" },
    "tool_request_id": { "type": "string", "minLength": 1 },
    "risk_level": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
    "target": { "type": "string", "minLength": 1 },
    "expected_effect": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "required": ["actions", "resources", "egress", "ttl_seconds"],
      "additionalProperties": true,
      "properties": {
        "actions": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "array", "items": { "type": "string" } },
        "egress": { "type": "array", "items": { "type": "string" } },
        "ttl_seconds": { "type": "number", "minimum": 1 }
      }
    },
    "choices": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
