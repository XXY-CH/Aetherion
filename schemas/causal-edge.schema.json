{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/causal-edge.schema.json",
  "title": "CausalEdge",
  "type": "object",
  "required": ["id", "from_event", "to_event", "relation", "confidence", "source_events", "projection_basis"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^causal_[A-Za-z0-9_-]+$" },
    "from_event": { "type": "string" },
    "to_event": { "type": "string" },
    "relation": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source_events": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "projection_basis": { "type": "string", "enum": ["typed_event_sequence"] }
  }
}
