{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/local-ingress-idempotency-completion.schema.json",
  "title": "LocalIngressIdempotencyCompletion",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "workspace_id",
    "reservation_id",
    "idempotency_key_hash",
    "normalized_intent_hash",
    "source_run_id",
    "cached_at",
    "surface_id",
    "command",
    "completion_stage",
    "cache_state",
    "replay_scope",
    "source_manifest_status",
    "source_manifest_event_ids",
    "source_artifact_refs",
    "source_artifact_ref_count",
    "source_head_event_id",
    "source_head_event_hash",
    "source_chain_valid",
    "live_side_effects_replayed",
    "replay_performs_live_side_effects",
    "replay_requires_new_policy",
    "replay_requires_new_lease",
    "replay_authorizes_actions",
    "policy_handoff",
    "raw_key_persisted",
    "raw_intent_persisted",
    "can_authorize_actions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^local_ingress_idempotency_completion_[a-f0-9]{16}$" },
    "schema_version": { "type": "string", "enum": ["aetherion-local-ingress-idempotency-completion-v1"] },
    "workspace_id": { "type": "string", "pattern": "^ws_[a-f0-9]{16}$" },
    "reservation_id": { "type": "string", "pattern": "^local_ingress_idempotency_[a-f0-9]{16}$" },
    "idempotency_key_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "normalized_intent_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source_run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]+$" },
    "cached_at": { "type": "string", "format": "date-time" },
    "surface_id": { "type": "string", "enum": ["tui"] },
    "command": { "type": "string", "enum": ["run"] },
    "completion_stage": { "type": "string", "enum": ["after_run_manifest_completed"] },
    "cache_state": { "type": "string", "enum": ["replay_available"] },
    "replay_scope": { "type": "string", "enum": ["same_key_same_normalized_intent_completed_tui_run"] },
    "source_manifest_status": { "type": "string", "enum": ["completed"] },
    "source_manifest_event_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$" }
    },
    "source_artifact_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^artifact://[A-Za-z0-9_./:-]+$" },
      "uniqueItems": true
    },
    "source_artifact_ref_count": { "type": "integer", "minimum": 0 },
    "source_head_event_id": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$" },
    "source_head_event_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source_chain_valid": { "type": "boolean", "enum": [true] },
    "live_side_effects_replayed": { "type": "boolean", "enum": [false] },
    "replay_performs_live_side_effects": { "type": "boolean", "enum": [false] },
    "replay_requires_new_policy": { "type": "boolean", "enum": [false] },
    "replay_requires_new_lease": { "type": "boolean", "enum": [false] },
    "replay_authorizes_actions": { "type": "boolean", "enum": [false] },
    "policy_handoff": { "type": "string", "enum": ["not_reused_replay_only"] },
    "raw_key_persisted": { "type": "boolean", "enum": [false] },
    "raw_intent_persisted": { "type": "boolean", "enum": [false] },
    "can_authorize_actions": { "type": "boolean", "enum": [false] }
  }
}
