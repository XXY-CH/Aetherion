{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/persona-anchor.schema.json",
  "title": "PersonaAnchor",
  "type": "object",
  "required": ["id", "branch", "kind", "content", "source_events", "confidence", "ttl", "created_at", "expires_at", "allowed_contexts", "blocked_contexts", "review_status", "sensitivity", "sensitive_approval_required", "sensitive_approved"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^anchor_[A-Za-z0-9_-]+$" },
    "branch": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["style", "preference", "principle"] },
    "content": { "type": "string", "minLength": 1 },
    "source_events": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "ttl": { "type": "string", "pattern": "^[1-9][0-9]*(d|h)$" },
    "created_at": { "type": "string" },
    "expires_at": { "type": "string" },
    "allowed_contexts": { "type": "array", "items": { "type": "string" } },
    "blocked_contexts": { "type": "array", "items": { "type": "string" } },
    "review_status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
    "sensitivity": { "type": "string" },
    "sensitive_approval_required": { "type": "boolean" },
    "sensitive_approved": { "type": "boolean" }
  }
}
