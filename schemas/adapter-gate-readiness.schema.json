{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/adapter-gate-readiness.schema.json",
  "title": "AdapterGateReadiness",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "status",
    "adapter_families",
    "gate_controls",
    "execution_boundary",
    "policy_matrix",
    "authority",
    "limits",
    "source_files"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^adapter_gate_readiness_[A-Za-z0-9_-]+$" },
    "schema_version": { "type": "string", "enum": ["aetherion-adapter-gate-readiness-v1"] },
    "status": { "type": "string", "enum": ["design_contract"] },
    "adapter_families": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/adapterFamily" }
    },
    "gate_controls": {
      "type": "object",
      "required": [
        "identity",
        "vault",
        "policy",
        "lease",
        "approval",
        "observation",
        "verification",
        "replay",
        "egress",
        "taint",
        "supervisor_action_gateway"
      ],
      "additionalProperties": false,
      "properties": {
        "identity": { "$ref": "#/$defs/controlState" },
        "vault": { "$ref": "#/$defs/controlState" },
        "policy": { "$ref": "#/$defs/controlState" },
        "lease": { "$ref": "#/$defs/controlState" },
        "approval": { "$ref": "#/$defs/controlState" },
        "observation": { "$ref": "#/$defs/controlState" },
        "verification": { "$ref": "#/$defs/controlState" },
        "replay": { "$ref": "#/$defs/controlState" },
        "egress": { "$ref": "#/$defs/controlState" },
        "taint": { "$ref": "#/$defs/controlState" },
        "supervisor_action_gateway": { "$ref": "#/$defs/controlState" }
      }
    },
    "execution_boundary": {
      "type": "object",
      "required": [
        "real_adapter_execution_enabled",
        "browser_extension_runtime_enabled",
        "browser_automation_enabled",
        "desktop_automation_enabled",
        "im_delivery_enabled",
        "mcp_connector_runtime_enabled",
        "oauth_saas_connector_runtime_enabled",
        "local_api_gateway_enabled",
        "package_code_execution_enabled",
        "cloud_worker_execution_enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "real_adapter_execution_enabled": { "type": "boolean", "enum": [false] },
        "browser_extension_runtime_enabled": { "type": "boolean", "enum": [false] },
        "browser_automation_enabled": { "type": "boolean", "enum": [false] },
        "desktop_automation_enabled": { "type": "boolean", "enum": [false] },
        "im_delivery_enabled": { "type": "boolean", "enum": [false] },
        "mcp_connector_runtime_enabled": { "type": "boolean", "enum": [false] },
        "oauth_saas_connector_runtime_enabled": { "type": "boolean", "enum": [false] },
        "local_api_gateway_enabled": { "type": "boolean", "enum": [false] },
        "package_code_execution_enabled": { "type": "boolean", "enum": [false] },
        "cloud_worker_execution_enabled": { "type": "boolean", "enum": [false] }
      }
    },
    "policy_matrix": {
      "type": "object",
      "required": [
        "matrix_kind",
        "typed_target_families_required",
        "deny_first_rules_required",
        "fresh_policy_required_per_action",
        "egress_policy_required",
        "connector_grant_lifecycle_required",
        "policy_matrix_can_issue_lease",
        "policy_matrix_can_execute_adapter"
      ],
      "additionalProperties": false,
      "properties": {
        "matrix_kind": { "type": "string", "enum": ["required_before_runtime_adapter_enablement"] },
        "typed_target_families_required": { "type": "boolean", "enum": [true] },
        "deny_first_rules_required": { "type": "boolean", "enum": [true] },
        "fresh_policy_required_per_action": { "type": "boolean", "enum": [true] },
        "egress_policy_required": { "type": "boolean", "enum": [true] },
        "connector_grant_lifecycle_required": { "type": "boolean", "enum": [true] },
        "policy_matrix_can_issue_lease": { "type": "boolean", "enum": [false] },
        "policy_matrix_can_execute_adapter": { "type": "boolean", "enum": [false] }
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "local_supervisor_is_root_authority",
        "event_ledger_is_fact_layer",
        "tool_policy_proxy_gates_side_effects",
        "adapter_manifest_can_authorize_actions",
        "adapter_gate_contract_can_issue_lease",
        "adapter_can_bypass_supervisor",
        "adapter_observation_can_authorize_side_effects",
        "generated_package_can_be_trust_root"
      ],
      "additionalProperties": false,
      "properties": {
        "local_supervisor_is_root_authority": { "type": "boolean", "enum": [true] },
        "event_ledger_is_fact_layer": { "type": "boolean", "enum": [true] },
        "tool_policy_proxy_gates_side_effects": { "type": "boolean", "enum": [true] },
        "adapter_manifest_can_authorize_actions": { "type": "boolean", "enum": [false] },
        "adapter_gate_contract_can_issue_lease": { "type": "boolean", "enum": [false] },
        "adapter_can_bypass_supervisor": { "type": "boolean", "enum": [false] },
        "adapter_observation_can_authorize_side_effects": { "type": "boolean", "enum": [false] },
        "generated_package_can_be_trust_root": { "type": "boolean", "enum": [false] }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "real_browser_automation_implemented",
        "real_desktop_automation_implemented",
        "real_im_delivery_implemented",
        "real_mcp_adapter_implemented",
        "real_oauth_connector_implemented",
        "real_local_api_gateway_implemented",
        "real_package_execution_implemented",
        "real_cloud_worker_implemented",
        "supervisor_governed_adapter_action_gateway_implemented",
        "connector_grants_implemented",
        "vault_secret_resolution_implemented",
        "token_refresh_revocation_implemented"
      ],
      "additionalProperties": false,
      "properties": {
        "real_browser_automation_implemented": { "type": "boolean", "enum": [false] },
        "real_desktop_automation_implemented": { "type": "boolean", "enum": [false] },
        "real_im_delivery_implemented": { "type": "boolean", "enum": [false] },
        "real_mcp_adapter_implemented": { "type": "boolean", "enum": [false] },
        "real_oauth_connector_implemented": { "type": "boolean", "enum": [false] },
        "real_local_api_gateway_implemented": { "type": "boolean", "enum": [false] },
        "real_package_execution_implemented": { "type": "boolean", "enum": [false] },
        "real_cloud_worker_implemented": { "type": "boolean", "enum": [false] },
        "supervisor_governed_adapter_action_gateway_implemented": { "type": "boolean", "enum": [false] },
        "connector_grants_implemented": { "type": "boolean", "enum": [false] },
        "vault_secret_resolution_implemented": { "type": "boolean", "enum": [false] },
        "token_refresh_revocation_implemented": { "type": "boolean", "enum": [false] }
      }
    },
    "source_files": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "adapterFamily": {
      "type": "object",
      "required": [
        "family",
        "manifest_status",
        "runtime_status",
        "requires_controls",
        "raw_secret_persistence_allowed",
        "raw_untrusted_payload_persistence_allowed",
        "live_side_effect_replay_allowed",
        "can_authorize_actions",
        "can_bypass_supervisor"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "enum": [
            "browser_extension",
            "browser_automation",
            "desktop_automation",
            "im_delivery",
            "mcp_connector",
            "oauth_saas_connector",
            "computer_use",
            "local_api_gateway",
            "package_execution",
            "cloud_worker"
          ]
        },
        "manifest_status": { "type": "string", "enum": ["required_before_runtime"] },
        "runtime_status": { "type": "string", "enum": ["deferred_not_implemented"] },
        "requires_controls": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "string",
            "enum": [
              "identity",
              "vault_reference",
              "fresh_policy_decision",
              "scoped_lease",
              "approval_for_side_effects",
              "observation_artifact",
              "verification_record",
              "no_live_side_effect_replay",
              "egress_policy",
              "taint_handling",
              "supervisor_action_gateway"
            ]
          },
          "uniqueItems": true
        },
        "raw_secret_persistence_allowed": { "type": "boolean", "enum": [false] },
        "raw_untrusted_payload_persistence_allowed": { "type": "boolean", "enum": [false] },
        "live_side_effect_replay_allowed": { "type": "boolean", "enum": [false] },
        "can_authorize_actions": { "type": "boolean", "enum": [false] },
        "can_bypass_supervisor": { "type": "boolean", "enum": [false] }
      }
    },
    "controlState": {
      "type": "object",
      "required": ["required_before_runtime", "implemented_for_all_adapter_families", "evidence_only"],
      "additionalProperties": false,
      "properties": {
        "required_before_runtime": { "type": "boolean", "enum": [true] },
        "implemented_for_all_adapter_families": { "type": "boolean", "enum": [false] },
        "evidence_only": { "type": "boolean", "enum": [true] }
      }
    }
  }
}
