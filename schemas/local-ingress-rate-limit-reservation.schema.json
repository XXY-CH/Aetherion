{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/local-ingress-rate-limit-reservation.schema.json",
  "title": "LocalIngressRateLimitReservation",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "workspace_id",
    "run_id",
    "reserved_at",
    "surface_id",
    "command",
    "rate_limit_key_hash",
    "normalized_intent_hash",
    "window_started_at",
    "window_ends_at",
    "window_size_ms",
    "max_requests",
    "slot_index",
    "remaining_after",
    "rate_limit_state",
    "enforcement_stage",
    "enforcer",
    "auth_state",
    "policy_handoff",
    "raw_key_persisted",
    "raw_intent_persisted",
    "can_authorize_actions",
    "issues_session",
    "background_queue_implemented"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^local_ingress_rate_limit_[a-f0-9]{16}_[0-9]+$" },
    "schema_version": { "type": "string", "enum": ["aetherion-local-ingress-rate-limit-reservation-v1"] },
    "workspace_id": { "type": "string", "pattern": "^ws_[a-f0-9]{16}$" },
    "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]+$" },
    "reserved_at": { "type": "string", "format": "date-time" },
    "surface_id": { "type": "string", "enum": ["tui"] },
    "command": { "type": "string", "enum": ["run"] },
    "rate_limit_key_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "normalized_intent_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "window_started_at": { "type": "string", "format": "date-time" },
    "window_ends_at": { "type": "string", "format": "date-time" },
    "window_size_ms": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
    "max_requests": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "slot_index": { "type": "integer", "minimum": 0 },
    "remaining_after": { "type": "integer", "minimum": 0 },
    "rate_limit_state": { "type": "string", "enum": ["enforced_allow"] },
    "enforcement_stage": { "type": "string", "enum": ["before_supervisor_handoff"] },
    "enforcer": { "type": "string", "enum": ["local_atomic_window_slot"] },
    "auth_state": { "type": "string", "enum": ["local_operator"] },
    "policy_handoff": { "type": "string", "enum": ["pending_fresh_policy_and_scoped_lease"] },
    "raw_key_persisted": { "type": "boolean", "enum": [false] },
    "raw_intent_persisted": { "type": "boolean", "enum": [false] },
    "can_authorize_actions": { "type": "boolean", "enum": [false] },
    "issues_session": { "type": "boolean", "enum": [false] },
    "background_queue_implemented": { "type": "boolean", "enum": [false] }
  }
}
