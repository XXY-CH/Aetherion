{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/schemas/event.schema.json",
  "title": "Event",
  "type": "object",
  "required": ["id", "timestamp", "workspace_id", "run_id", "event_type", "actor", "summary", "hash_version", "sensitivity", "taint"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "workspace_id": { "type": "string" },
    "run_id": { "type": "string" },
    "event_type": {
      "type": "string",
      "enum": [
        "run.started",
        "user.message",
        "tool.requested",
        "risk.composed",
        "policy.decided",
        "lease.issued",
        "tool.result",
        "tool.executing",
        "tool.denied",
        "action.recorded",
        "consent.recorded",
        "observation.recorded",
        "verification.recorded",
        "memory.candidate",
        "memory.candidate.created",
        "memory.accepted",
        "memory.rejected",
        "memory.blocked",
        "capability.candidate",
        "proactive.opportunity",
        "replay.recorded",
        "artifact.redacted",
        "event.redacted",
        "memory.deleted",
        "wakeup.queued",
        "memory.fold.proposed",
        "memory.fold.accepted",
        "memory.fold.rejected",
        "persona.anchor.proposed",
        "persona.anchor.accepted",
        "persona.anchor.rejected",
        "persona.reset.applied",
        "soul.fork.created",
        "capsule.draft.recorded",
        "capsule.test.recorded",
        "capsule.publish.recorded",
        "capsule.rollback.recorded",
        "agent.contract.created",
        "agent.runtime.bound",
        "agent.model.requested",
        "agent.model.responded",
        "agent.response.audit.recorded",
        "agent.tool.request.proposed",
        "agent.child.started",
        "agent.child.policy_denied",
        "agent.child.completed",
        "agent.loop.completed",
        "agent.loop.depth_exceeded",
        "circuit.opened",
        "security.content.assessed",
        "poisoning.detected",
        "poisoning.acknowledged",
        "honeypot.trial.completed",
        "poisoning.regression.created",
        "browser.observation.ingested",
        "im.inbox.received",
        "im.outbox.queued",
        "store.publisher.trusted",
        "capsule.store.installed",
        "run.completed",
        "vcs.snapshot.created",
        "vcs.rollback.applied",
        "vcs.branch.created",
        "vcs.branch.merged",
        "context.epoch.recorded",
        "context.epoch.violation",
        "tool.settled"
      ]
    },
    "actor": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["user", "agent", "system", "connector", "worker"] },
        "id": { "type": "string" }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "hash_version": { "type": "string", "enum": ["aetherion-event-v1"] },
    "payload_ref": { "type": "string" },
    "parent_event_id": { "type": "string" },
    "parent_event_hash": { "type": "string" },
    "event_hash": { "type": "string" },
    "sensitivity": { "type": "string", "enum": ["public", "internal", "private", "confidential", "secret", "regulated", "credential-like"] },
    "taint": {
      "type": "object",
      "required": ["sources", "can_authorize_actions"],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": { "type": "string", "enum": ["user", "trusted_system", "connector", "public_web", "email", "pdf", "im", "github_issue", "mcp_description", "third_party_content", "llm_output", "child_agent"] }
        },
        "can_authorize_actions": { "type": "boolean" }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttl": { "type": "string" },
        "user_deletable": { "type": "boolean" }
      }
    },
    "links": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
