{
  "name": "aetherion-kernel",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "ether": "packages/tui/src/cli.ts"
  },
  "scripts": {
    "test": "node --test packages/*/test/*.test.ts",
    "test:go-tui": "GOCACHE=/tmp/aetherion-go-build-cache go test ./packages/tui-go/...",
    "test:rust": "cargo test --locked",
    "test:all": "npm test && npm run test:go-tui && cargo test --locked",
    "ether": "node packages/tui/src/cli.ts",
    "ether:setup": "node packages/tui/src/cli.ts setup",
    "ether:workbench": "node packages/tui/src/cli.ts setup"
  },
  "engines": {
    "node": ">=24.9.0"
  }
}
